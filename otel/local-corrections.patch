@@ -0,0 +1,38 @@
+# Keep this a simple script. An advanced parameter block would intercept native
+# options such as Docker's -v and -d as PowerShell's -Verbose and -Debug.
+if ($args.Count -eq 0) {
+    $Executable = 'npm'
+    $CommandArgs = @('run', 'verify:signals')
+} else {
+    $Executable = [string]$args[0]
+    $CommandArgs = @($args | Select-Object -Skip 1)
+}
+
+$ErrorActionPreference = 'Stop'
+$savedEnvironment = @{}
+$originalLocation = Get-Location
+$commandExitCode = 1
+
+try {
+    # Clear these before npm or Node starts: clearing NODE_OPTIONS from
+    # JavaScript is too late to prevent an inherited preload from executing.
+    foreach ($entry in Get-ChildItem Env:) {
+        if ($entry.Name -match '^(OTEL_|GRAFANA_CLOUD_)|^(NODE_OPTIONS|NODE_PATH|NODE_USE_ENV_PROXY|npm_config_node_options|COMPOSE_FILE)$') {
+            $savedEnvironment[$entry.Name] = $entry.Value
+            Remove-Item -LiteralPath "Env:$($entry.Name)"
+        }
+    }
+    Set-Location -LiteralPath (Split-Path -Parent $PSScriptRoot)
+    if ($Executable -eq 'npm' -and $env:OS -eq 'Windows_NT') {
+        $Executable = 'npm.cmd'
+    }
+    & $Executable @CommandArgs
+    $commandExitCode = $LASTEXITCODE
+} finally {
+    Set-Location -LiteralPath $originalLocation.Path
+    foreach ($entry in $savedEnvironment.GetEnumerator()) {
+        Set-Item -LiteralPath "Env:$($entry.Key)" -Value $entry.Value
+    }
+}
+
+exit $commandExitCode

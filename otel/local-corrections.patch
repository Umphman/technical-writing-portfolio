@@ -0,0 +1,262 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { assertSplit } = require('../scripts/verify-context');
+const { analyzeTempoTrace, verifiedTempoTrace } = require('../scripts/verify-pipeline');
+
+const checkoutTraceId = 'a'.repeat(32);
+const inventoryTraceId = 'b'.repeat(32);
+const probeId = 'target';
+const ids = {
+  root: '1111111111111111',
+  checkout: '2222222222222222',
+  client: '3333333333333333',
+  server: '4444444444444444',
+  inventory: '5555555555555555',
+  other: '6666666666666666',
+};
+const attribute = (key, value) => ({ key, value: { stringValue: value } });
+const base64 = (hex) => Buffer.from(hex, 'hex').toString('base64');
+function span(name, id, parent, probe, traceId = checkoutTraceId) {
+  return {
+    name,
+    traceId,
+    spanId: id,
+    ...(parent ? { parentSpanId: parent } : {}),
+    attributes: probe === undefined ? [] : [attribute('checkout.id', probe)],
+  };
+}
+function group(spans, namespace = 'otel-onboarding') {
+  return {
+    resource: { attributes: [
+      attribute('service.name', 'checkout-api'),
+      attribute('service.namespace', namespace),
+      attribute('service.version', '1.0.0'),
+      attribute('deployment.environment.name', 'local'),
+    ] },
+    scopeSpans: [{ spans }],
+  };
+}
+function trace(spans, namespace) {
+  return { batches: [group(spans, namespace)] };
+}
+function chain() {
+  return [
+    span('POST /checkout', ids.root),
+    span('checkout.process', ids.checkout, ids.root, probeId),
+    span('POST', ids.client, ids.checkout),
+    span('POST /inventory/reserve', ids.server, ids.client),
+    span('inventory.reserve', ids.inventory, ids.server, probeId),
+  ];
+}
+const analyze = (payload, requiredSpans) => (
+  analyzeTempoTrace(payload, probeId, checkoutTraceId, requiredSpans)
+);
+const query = (payload, requiredSpans) => verifiedTempoTrace(
+  async () => ({ stdout: JSON.stringify(payload) }), checkoutTraceId, probeId, requiredSpans,
+);
+
+test('broken-context probe rejects healthy and uninstrumented responses', () => {
+  assert.throws(() => assertSplit({ telemetry: {
+    checkoutTraceId, inventoryTraceId: checkoutTraceId, contextPropagationHealthy: true,
+  } }), /split the trace/u);
+  assert.throws(() => assertSplit({}), /Missing checkout trace ID/u);
+  assert.deepEqual(assertSplit({ telemetry: {
+    checkoutTraceId, inventoryTraceId, contextPropagationHealthy: false,
+  } }), { checkoutTraceId, inventoryTraceId });
+});
+
+test('single-operation Tempo checks require the exact probe, identity and returned trace ID', async () => {
+  const checkout = span('checkout.process', ids.checkout, undefined, probeId);
+  assert.equal(analyze(trace([{ ...checkout, attributes: [attribute('checkout.id', 'other')] }]),
+    ['checkout.process']).hasProbe, false);
+  assert.equal(analyze(trace([checkout], 'other-service'), ['checkout.process']).identityMatches, false);
+  assert.equal(await query(trace([{ ...checkout, traceId: inventoryTraceId }]), ['checkout.process']), false);
+  const result = await query(trace([checkout]), ['checkout.process']);
+  assert.equal(result.accepted, true);
+  assert.equal(result.ancestryRequired, false);
+  assert.equal(result.ancestry.matched, false);
+});
+
+test('split inventory trace passes only its expected ID without claiming ancestry', async () => {
+  const payload = trace([span('inventory.reserve', ids.inventory, undefined, probeId, inventoryTraceId)]);
+  const result = await verifiedTempoTrace(
+    async () => ({ stdout: JSON.stringify(payload) }), inventoryTraceId, probeId, ['inventory.reserve'],
+  );
+  assert.equal(result.accepted, true);
+  assert.equal(result.ancestryRequired, false);
+  assert.equal(await query(payload, ['inventory.reserve']), false);
+  assert.equal(await query(payload), false);
+});
+
+test('normal pipeline requires both operations and a proven parent chain', async () => {
+  const checkout = span('checkout.process', ids.checkout, undefined, probeId);
+  assert.equal(analyze(trace([checkout])).requiredSpansPresent, false);
+  assert.equal(await query(trace([checkout])), false);
+  const result = await query(trace([
+    checkout, span('inventory.reserve', ids.inventory, ids.checkout, probeId),
+  ]));
+  assert.equal(result.accepted, true);
+  assert.equal(result.ancestry.matched, true);
+  assert.deepEqual(result.ancestry.path.map((item) => item.spanId), [ids.checkout, ids.inventory]);
+});
+
+test('HTTP intermediates across resource and scope groups establish explicit ancestry', async () => {
+  const [root, checkout, client, server, inventory] = chain();
+  const first = group([root]);
+  first.scopeSpans.push({ spans: [checkout] });
+  const result = await query({ batches: [group([inventory]), group([client, server]), first] });
+  assert.equal(result.accepted, true);
+  assert.equal(result.expectedTraceId, checkoutTraceId);
+  assert.equal(result.ancestry.checkoutSpanId, ids.checkout);
+  assert.equal(result.ancestry.inventorySpanId, ids.inventory);
+  assert.equal(result.ancestry.rootSpanId, ids.root);
+  assert.deepEqual(result.ancestry.path.map((item) => item.spanId),
+    [ids.root, ids.checkout, ids.client, ids.server, ids.inventory]);
+});
+
+test('Tempo protobuf base64 and OTLP uppercase hex IDs normalize to the same parent chain', async () => {

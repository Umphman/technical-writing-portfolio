+'use strict';
+
+// A generic OTLP endpoint does not override signal-specific endpoints. Remove
+// inherited configuration before adding the verification case's explicit values.
+function isolatedVerificationEnv(source = process.env) {
+  return Object.fromEntries(Object.entries(source).filter(([name]) => (
+    !/^(OTEL_|GRAFANA_CLOUD_)/iu.test(name)
+    && !/^(NODE_OPTIONS|NODE_PATH|NODE_USE_ENV_PROXY|npm_config_node_options|COMPOSE_FILE)$/iu.test(name)
+  )));
+}
+
+module.exports = { isolatedVerificationEnv };

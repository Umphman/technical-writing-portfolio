+  const snapshot = { ...input };
+  assert.deepEqual(isolatedVerificationEnv(input), {
+    ...intended,
+    Path: 'system-search-path',
+    TEMP: 'temporary-directory',
+    SIGNAL_VERIFY_START_TIMEOUT_MS: '90000',
+  });
+  assert.deepEqual(input, snapshot);
+});
+
+test('verification env handles case-insensitive Windows variable names', () => {
+  assert.deepEqual(isolatedVerificationEnv({
+    otel_exporter_otlp_logs_endpoint: 'http://127.0.0.1:9',
+    Node_Options: '--require=missing',
+    NPM_CONFIG_NODE_OPTIONS: '--require=missing',
+    compose_file: '/nonexistent-verification-compose.yml',

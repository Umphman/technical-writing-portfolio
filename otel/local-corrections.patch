+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { existsSync } = require('node:fs');
+const path = require('node:path');
+const { spawnSync } = require('node:child_process');
+const { isolatedVerificationEnv } = require('../scripts/verification-env');
+
+const root = path.resolve(__dirname, '..');
+const fixture = path.join(__dirname, 'fixtures', 'inspect-verification-env.fixture');
+const conflicting = {
+  OTEL_EXPORTER_OTLP_TRACES_ENDPOINT: 'http://127.0.0.1:9/unwanted-traces',
+  OTEL_EXPORTER_OTLP_METRICS_ENDPOINT: 'http://127.0.0.1:9/unwanted-metrics',
+  OTEL_EXPORTER_OTLP_LOGS_ENDPOINT: 'http://127.0.0.1:9/unwanted-logs',
+  OTEL_EXPORTER_OTLP_HEADERS: 'test=unwanted',
+  OTEL_SDK_DISABLED: 'true',
+  OTEL_TRACES_SAMPLER: 'always_off',
+  GRAFANA_CLOUD_TOKEN: 'synthetic-test-value',
+  NODE_OPTIONS: '--require=./test/fixtures/nonexistent-preload.cjs',
+  NODE_PATH: '/nonexistent-verification-modules',
+  NODE_USE_ENV_PROXY: '1',
+  npm_config_node_options: '--require=./test/fixtures/nonexistent-npm-preload.cjs',
+  otel_verification_mixed_case: 'also-unwanted',
+  COMPOSE_FILE: '/nonexistent-verification-compose.yml',
+};
+const intended = {
+  COMPOSE_PROJECT_NAME: 'otel-verification-fixture',
+  DEMO_HTTP_PORT: '18080',
+  PIPELINE_APP_URL: 'http://127.0.0.1:18080',
+};
+const expectedChild = {
+  unexpectedNames: [],
+  project: intended.COMPOSE_PROJECT_NAME,
+  port: intended.DEMO_HTTP_PORT,
+  appUrl: intended.PIPELINE_APP_URL,
+};
+
+test('verification env removes inherited exporters, credentials and preloads without mutating its input', () => {
+  const input = { ...conflicting, ...intended, Path: 'system-search-path', TEMP: 'temporary-directory', SIGNAL_VERIFY_START_TIMEOUT_MS: '90000' };
+  const snapshot = { ...input };
+  assert.deepEqual(isolatedVerificationEnv(input), {
+    ...intended,
+    Path: 'system-search-path',
+    TEMP: 'temporary-directory',
+    SIGNAL_VERIFY_START_TIMEOUT_MS: '90000',
+  });
+  assert.deepEqual(input, snapshot);
+});
+
+test('verification env handles case-insensitive Windows variable names', () => {
+  assert.deepEqual(isolatedVerificationEnv({
+    otel_exporter_otlp_logs_endpoint: 'http://127.0.0.1:9',
+    Node_Options: '--require=missing',
+    NPM_CONFIG_NODE_OPTIONS: '--require=missing',
+    compose_file: '/nonexistent-verification-compose.yml',
+    keep: 'yes',
+  }), { keep: 'yes' });
+});
+
+test('PowerShell launcher clears configuration before Node can execute a preload', {
+  skip: process.platform !== 'win32',
+}, () => {
+  const result = spawnSync('powershell.exe', [
+    '-NoProfile', '-ExecutionPolicy', 'RemoteSigned', '-File',
+    path.join(root, 'scripts', 'run-local.ps1'), process.execPath, fixture,
+  ], { cwd: root, env: { ...process.env, ...conflicting, ...intended }, encoding: 'utf8', windowsHide: true });
+  assert.equal(result.status, 0, result.stderr || result.error?.message);
+  assert.deepEqual(JSON.parse(result.stdout.trim()), expectedChild);
+});
+
+test('PowerShell launcher forwards native flags without consuming common-parameter abbreviations', {
+  skip: process.platform !== 'win32',
+}, () => {
+  const nativeArgs = ['compose', '-d', '-v', '-f', 'file with spaces.yml', '--wait', '--remove-orphans'];
+  const result = spawnSync('powershell.exe', [
+    '-NoProfile', '-ExecutionPolicy', 'RemoteSigned', '-File',
+    path.join(root, 'scripts', 'run-local.ps1'), process.execPath,
+    path.join(__dirname, 'fixtures', 'inspect-arguments.fixture'), ...nativeArgs,
+  ], { cwd: root, env: process.env, encoding: 'utf8', windowsHide: true });
+  assert.equal(result.status, 0, result.stderr || result.error?.message);
+  assert.deepEqual(JSON.parse(result.stdout.trim()), nativeArgs);
+});
+
+const gitBash = 'C:\\Program Files\\Git\\bin\\bash.exe';
+test('POSIX launcher clears configuration before Node can execute a preload', {
+  skip: process.platform === 'win32' && !existsSync(gitBash),
+}, () => {
+  const toShellPath = (value) => value.replace(/\\/gu, '/');
+  const result = spawnSync(process.platform === 'win32' ? gitBash : 'sh', [
+    toShellPath(path.join(root, 'scripts', 'run-local.sh')),
+    toShellPath(process.execPath), toShellPath(fixture),
+  ], { cwd: root, env: { ...process.env, ...conflicting, ...intended }, encoding: 'utf8', windowsHide: true });
+  assert.equal(result.status, 0, result.stderr || result.error?.message);
+  assert.deepEqual(JSON.parse(result.stdout.trim()), expectedChild);
+});

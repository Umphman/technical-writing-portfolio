+test('operation IDs are validated in single-operation verification as well', async () => {
+  const checkout = span('checkout.process', ids.checkout, undefined, probeId);
+  assert.equal(await query(trace([{ ...checkout, spanId: 'invalid' }]), ['checkout.process']), false);
+  assert.equal(await query(trace([checkout, { ...checkout }]), ['checkout.process']), false);

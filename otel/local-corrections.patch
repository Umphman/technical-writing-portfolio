+test('conflicting duplicate probe or identity attributes cannot win by ordering', async () => {
+  for (const reverse of [false, true]) {
+    const spans = chain();
+    const probes = [attribute('checkout.id', 'other'), attribute('checkout.id', probeId)];
+    spans[4].attributes = reverse ? probes.reverse() : probes;
+    assert.equal(await query(trace(spans)), false);
+    const payload = trace(chain());
+    const resources = payload.batches[0].resource.attributes;

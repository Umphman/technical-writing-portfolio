@@ -0,0 +1,71 @@
+'use strict';
+
+const assert = require('node:assert/strict');
+const { randomUUID } = require('node:crypto');
+const {
+  analyzeTempoTrace,
+  createDockerRunner,
+  fetchJson,
+  pollFor,
+  requireServices,
+  resolveDocker,
+  tempoTrace,
+} = require('./verify-pipeline');
+
+function assertSplit(checkout) {
+  const { checkoutTraceId, inventoryTraceId, contextPropagationHealthy } = checkout?.telemetry || {};
+  assert.match(checkoutTraceId || '', /^[0-9a-f]{32}$/u, 'Missing checkout trace ID.');
+  assert.match(inventoryTraceId || '', /^[0-9a-f]{32}$/u, 'Missing inventory trace ID.');
+  assert.notEqual(inventoryTraceId, checkoutTraceId, 'Expected the scenario to split the trace.');
+  assert.equal(contextPropagationHealthy, false, 'Expected the broken-context scenario.');
+  return { checkoutTraceId, inventoryTraceId };
+}
+
+async function runVerification() {
+  const runDocker = createDockerRunner(await resolveDocker());
+  await requireServices(runDocker);
+  const probeId = `broken-context-${randomUUID()}`;
+  const appUrl = process.env.PIPELINE_APP_URL || 'http://127.0.0.1:8080';
+  const checkout = await fetchJson(`${appUrl}/checkout`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({
+      checkoutId: probeId,
+      items: [{ sku: 'context-verification', quantity: 1 }],
+    }),
+  });
+  const { checkoutTraceId, inventoryTraceId } = assertSplit(checkout);
+  process.stdout.write(`probe: ${probeId}\n`);
+  process.stdout.write(`checkout trace: ${checkoutTraceId}\n`);
+  process.stdout.write(`inventory trace: ${inventoryTraceId}\n`);
+
+  // Check the stored traces, not only the IDs echoed by the application.
+  const deadline = Date.now() + 90_000;
+  const checkoutTrace = await pollFor('checkout trace in Tempo', async () => {
+    const payload = await tempoTrace(runDocker, checkoutTraceId);
+    const result = analyzeTempoTrace(payload, probeId, ['checkout.process']);
+    return result.identityMatches && result.hasProbe && result.requiredSpansPresent
+      ? result : false;
+  }, deadline);
+  const inventoryTrace = await pollFor('inventory trace in Tempo', async () => {
+    const payload = await tempoTrace(runDocker, inventoryTraceId);
+    const result = analyzeTempoTrace(payload, probeId, ['inventory.reserve']);
+    return result.identityMatches && result.hasProbe && result.requiredSpansPresent
+      ? result : false;
+  }, deadline);
+  assert.equal(checkoutTrace.spanNames.includes('inventory.reserve'), false,
+    'The checkout trace unexpectedly contains the inventory operation.');
+  assert.equal(inventoryTrace.spanNames.includes('checkout.process'), false,
+    'The inventory trace unexpectedly contains the checkout operation.');
+  process.stdout.write('Tempo: checkout.process and inventory.reserve found in separate traces for this probe\n');
+  process.stdout.write('broken-context verification passed (the expected defect is present)\n');
+}
+
+module.exports = { assertSplit };
+
+if (require.main === module) {
+  runVerification().catch((error) => {
+    process.stderr.write(`${error?.stack || error}\n`);
+    process.exitCode = 1;
+  });
+}

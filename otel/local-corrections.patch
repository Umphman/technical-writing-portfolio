new file mode 100644
--- /dev/null
+++ b/test/verify-compose.test.js
@@ -0,0 +1,50 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const os = require('node:os');
+const path = require('node:path');
+const { spawnSync } = require('node:child_process');
+const { createDockerRunner } = require('../scripts/verify-pipeline');
+
+// Compose config renders locally; these checks never contact the Docker daemon
+// or start containers. Keep npm test useful where the optional CLI is absent.
+const command = process.env.DOCKER_BIN || 'docker';
+const probe = spawnSync(command, ['compose', 'version'], {
+  encoding: 'utf8',
+  windowsHide: true,
+});
+const skip = probe.status !== 0 ? 'Docker Compose CLI is not available' : false;
+
+for (const conflict of ['missing file', 'different valid project']) {
+  test(`Compose verifier selects its stack with COMPOSE_FILE pointing to a ${conflict}`, { skip }, async (t) => {
+    const directory = await fs.mkdtemp(path.join(os.tmpdir(), 'otel-compose-test-'));
+    t.after(async () => {
+      assert.equal(path.dirname(directory), path.resolve(os.tmpdir()));
+      assert.ok(path.basename(directory).startsWith('otel-compose-test-'));
+      await fs.rm(directory, { recursive: true, force: true });
+    });
+    const conflictingFile = path.join(directory, 'unrelated.yml');
+    if (conflict === 'different valid project') {
+      await fs.writeFile(conflictingFile, 'services:\n  unrelated:\n    image: scratch\n');
+    }
+    const runner = createDockerRunner({
+      command,
+      env: {
+        ...process.env,
+        COMPOSE_FILE: conflictingFile,
+        COMPOSE_PROJECT_NAME: 'otel-verifier-test',
+        DEMO_HTTP_PORT: '18080',
+      },
+    });
+    const { stdout } = await runner(['compose', 'config', '--format', 'json']);
+    const config = JSON.parse(stdout);
+    assert.equal(config.name, 'otel-verifier-test');
+    assert.ok(config.services.app);
+    assert.ok(config.services.alloy);
+    assert.ok(config.services.lgtm);
+    assert.equal(config.services.unrelated, undefined);
+    assert.ok(config.services.app.ports.some((port) => port.published === '18080'));
+  });
+}

+++ b/test/verify-compose.test.js
@@ -0,0 +1,50 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const os = require('node:os');
+const path = require('node:path');
+const { spawnSync } = require('node:child_process');
+const { createDockerRunner } = require('../scripts/verify-pipeline');
+
+// Compose config renders locally; these checks never contact the Docker daemon
+// or start containers. Keep npm test useful where the optional CLI is absent.
+const command = process.env.DOCKER_BIN || 'docker';
+const probe = spawnSync(command, ['compose', 'version'], {
+  encoding: 'utf8',
+  windowsHide: true,
+});
+const skip = probe.status !== 0 ? 'Docker Compose CLI is not available' : false;
+
+for (const conflict of ['missing file', 'different valid project']) {
+  test(`Compose verifier selects its stack with COMPOSE_FILE pointing to a ${conflict}`, { skip }, async (t) => {
+    const directory = await fs.mkdtemp(path.join(os.tmpdir(), 'otel-compose-test-'));
+    t.after(async () => {
+      assert.equal(path.dirname(directory), path.resolve(os.tmpdir()));
+      assert.ok(path.basename(directory).startsWith('otel-compose-test-'));
+      await fs.rm(directory, { recursive: true, force: true });
+    });
+    const conflictingFile = path.join(directory, 'unrelated.yml');
+    if (conflict === 'different valid project') {
+      await fs.writeFile(conflictingFile, 'services:\n  unrelated:\n    image: scratch\n');
+    }
+    const runner = createDockerRunner({
+      command,
+      env: {
+        ...process.env,
+        COMPOSE_FILE: conflictingFile,
+        COMPOSE_PROJECT_NAME: 'otel-verifier-test',
+        DEMO_HTTP_PORT: '18080',
+      },
+    });
+    const { stdout } = await runner(['compose', 'config', '--format', 'json']);
+    const config = JSON.parse(stdout);
+    assert.equal(config.name, 'otel-verifier-test');
+    assert.ok(config.services.app);
+    assert.ok(config.services.alloy);
+    assert.ok(config.services.lgtm);
+    assert.equal(config.services.unrelated, undefined);
+    assert.ok(config.services.app.ports.some((port) => port.published === '18080'));
+  });
+}
diff --git a/test/verify-context.test.js b/test/verify-context.test.js
new file mode 100644
--- /dev/null
+++ b/test/verify-context.test.js
@@ -0,0 +1,46 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { assertSplit } = require('../scripts/verify-context');
+const { analyzeTempoTrace } = require('../scripts/verify-pipeline');
+
+const checkoutTraceId = 'a'.repeat(32);
+const inventoryTraceId = 'b'.repeat(32);
+const attribute = (key, value) => ({ key, value: { stringValue: value } });
+function trace(spans, namespace = 'otel-onboarding') {
+  return {
+    batches: [{
+      resource: { attributes: [
+        attribute('service.name', 'checkout-api'),
+        attribute('service.namespace', namespace),
+        attribute('service.version', '1.0.0'),
+        attribute('deployment.environment.name', 'local'),
+      ] },
+      scopeSpans: [{ spans: spans.map(([name, probe]) => ({
+        name, attributes: [attribute('checkout.id', probe)],
+      })) }],
+    }],
+  };
+}
+
+test('broken-context probe rejects healthy and uninstrumented responses', () => {
+  assert.throws(() => assertSplit({ telemetry: {
+    checkoutTraceId, inventoryTraceId: checkoutTraceId, contextPropagationHealthy: true,
+  } }), /split the trace/u);
+  assert.throws(() => assertSplit({}), /Missing checkout trace ID/u);
+  assert.deepEqual(assertSplit({ telemetry: {
+    checkoutTraceId, inventoryTraceId, contextPropagationHealthy: false,
+  } }), { checkoutTraceId, inventoryTraceId });
+});
+
+test('Tempo check requires the exact probe and service identity, not merely a span name', () => {
+  assert.equal(analyzeTempoTrace(trace([['checkout.process', 'other-probe']]), 'target', ['checkout.process']).hasProbe, false);
+  assert.equal(analyzeTempoTrace(trace([['checkout.process', 'target']], 'other-service'), 'target', ['checkout.process']).identityMatches, false);
+  assert.equal(analyzeTempoTrace(trace([['checkout.process', 'target']]), 'target', ['checkout.process']).requiredSpansPresent, true);
+});
+
+test('normal pipeline still requires both operations in the returned trace', () => {
+  assert.equal(analyzeTempoTrace(trace([['checkout.process', 'target']]), 'target').requiredSpansPresent, false);
+  assert.equal(analyzeTempoTrace(trace([['checkout.process', 'target'], ['inventory.reserve', 'target']]), 'target').requiredSpansPresent, true);
+});

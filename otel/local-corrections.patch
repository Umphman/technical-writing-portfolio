+    spanId: index % 2 ? item.spanId : base64(item.spanId),
+    ...(item.parentSpanId ? { parentSpanId: base64(item.parentSpanId) } : { parentSpanId: '' }),
+  }));
+  const result = await query({ resourceSpans: [group(spans)] });
+  assert.equal(result.accepted, true);
+  assert.deepEqual(result.ancestry.path.map((item) => item.spanId), chain().map((item) => item.spanId));
+});
+
+test('protobuf snake-case fields and unpadded base64 IDs retain exact ancestry', async () => {
+  const spans = chain().map((item) => ({
+    name: item.name,
+    attributes: item.attributes,
+    trace_id: base64(item.traceId).replace(/=+$/u, ''),
+    span_id: base64(item.spanId).replace(/=+$/u, ''),
+    ...(item.parentSpanId ? { parent_span_id: base64(item.parentSpanId) } : {}),

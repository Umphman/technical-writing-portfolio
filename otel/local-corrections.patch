+  batch.scope_spans = [{ spans }];
+  assert.equal((await query({ resource_spans: [batch] })).accepted, true);
+});
+
+const brokenChains = [
+  ['missing inventory parent', (spans) => { delete spans[4].parentSpanId; }],
+  ['orphaned parent ID', (spans) => { spans[4].parentSpanId = ids.other; }],
+  ['missing intermediate span', (spans) => { spans.splice(3, 1); }],
+  ['sibling branch', (spans) => { spans[4].parentSpanId = ids.root; }],
+  ['reversed operation ancestry', (spans) => {
+    spans[1].parentSpanId = ids.inventory;
+    spans[4].parentSpanId = ids.root;
+  }],
+  ['cycle below checkout', (spans) => { spans[2].parentSpanId = ids.server; }],
+  ['self-parenting inventory', (spans) => { spans[4].parentSpanId = ids.inventory; }],
+  ['cycle through checkout', (spans) => { spans[1].parentSpanId = ids.inventory; }],
+  ['cycle above checkout', (spans) => { spans[0].parentSpanId = ids.root; }],
+  ['missing parent above checkout', (spans) => { spans[0].parentSpanId = ids.other; }],
+  ['other probe on intermediate span', (spans) => {
+    spans[2].attributes = [attribute('checkout.id', 'other')];
+  }],
+  ['other trace on intermediate span', (spans) => { spans[2].traceId = inventoryTraceId; }],
+  ['duplicate intermediate ID', (spans) => { spans.push({ ...spans[2] }); }],
+  ['duplicate checkout ID', (spans) => { spans.push({ ...spans[1], name: 'unrelated' }); }],
+  ['duplicate inventory ID', (spans) => { spans.push({ ...spans[4], name: 'unrelated' }); }],
+  ['duplicate operation with another span ID', (spans) => {
+    spans.push({ ...spans[1], spanId: ids.other });
+  }],
+  ['invalid inventory ID', (spans) => { spans[4].spanId = 'invalid'; }],
+  ['zero span ID', (spans) => { spans[4].spanId = '0'.repeat(16); }],
+  ['invalid parent ID', (spans) => { spans[4].parentSpanId = 'xyz'; }],
+  ['zero parent ID', (spans) => { spans[4].parentSpanId = '0'.repeat(16); }],
+  ['malformed base64 parent ID', (spans) => { spans[4].parentSpanId = `${base64(ids.server)}!`; }],
+  ['wrong-width base64 parent ID', (spans) => { spans[4].parentSpanId = base64(checkoutTraceId); }],
+  ['conflicting parent aliases', (spans) => { spans[4].parent_span_id = ids.root; }],
+  ['conflicting span aliases', (spans) => { spans[4].span_id = ids.other; }],
+];
+for (const [name, mutate] of brokenChains) {
+  test(`normal Tempo acceptance rejects ${name} despite matching operations/probe/identity`, async () => {
+    const spans = chain();
+    mutate(spans);
+    const payload = trace(spans);
+    const result = analyze(payload);
+    assert.equal(result.requiredSpansPresent, true);
+    assert.equal(result.hasProbe, true);
+    assert.equal(result.identityMatches, true);
+    assert.equal(result.accepted, false);
+    assert.equal(await query(payload), false, 'The pipeline query must enforce ancestry and valid IDs.');
+  });
+}
+
+test('a different service identity cannot supply a parent or operation', async () => {
+  const spans = chain();
+  assert.equal(await query({ batches: [group(spans.slice(0, 2)), group([spans[2]], 'other'),
+    group(spans.slice(3))] }), false);
+  assert.equal(await query({ batches: [group(spans.slice(0, 4)), group([spans[4]], 'other')] }), false);
+});
+
+test('a duplicate chain ID in another resource group remains ambiguous', async () => {
+  const spans = chain();
+  assert.equal(await query({ batches: [group(spans), group([{ ...spans[2] }], 'other')] }), false);
+});
+
+test('unrelated resources, other traces and duplicate IDs off the claimed chain do not establish or break it', async () => {
+  const spans = chain();
+  const unrelated = span('unrelated', ids.other);
+  const payload = { batches: [
+    group(spans),
+    group([unrelated, { ...unrelated }], 'other'),
+    group(spans.map((item) => ({ ...item, traceId: inventoryTraceId }))),
+  ] };
+  assert.equal((await query(payload)).accepted, true);
+});
+
+test('a same-name checkout for another probe is not the exact ancestor', async () => {
+  const spans = chain();
+  spans[1].attributes = [attribute('checkout.id', 'other')];
+  spans.push(span('checkout.process', ids.other, ids.root, probeId));
+  assert.equal(analyze(trace(spans)).requiredSpansPresent, true);
+  assert.equal(await query(trace(spans)), false);
+});
+
+test('omitted, malformed, zero or different expected trace IDs cannot accept a matching graph', async () => {
+  const payload = trace(chain());
+  for (const expected of [undefined, '', 'invalid', '0'.repeat(32), inventoryTraceId]) {
+    assert.equal(analyzeTempoTrace(payload, probeId, expected).accepted, false);
+  }
+  for (const returnedId of [undefined, 'invalid', '0'.repeat(32), inventoryTraceId]) {
+    const spans = chain().map((item) => ({ ...item, traceId: returnedId }));
+    assert.equal(await query(trace(spans)), false);
+  }
+});

+#!/bin/sh
+set -eu
+
+# Do this in the shell, before Node or npm can execute inherited preloads.
+# Only environment variable names are read; values are neither printed nor run.
+for verification_name in $(env | awk -F= 'toupper($1) ~ /^(OTEL_|GRAFANA_CLOUD_)|^(NODE_OPTIONS|NODE_PATH|NODE_USE_ENV_PROXY|NPM_CONFIG_NODE_OPTIONS|COMPOSE_FILE)$/ {print $1}'); do
+  unset "$verification_name"
+done
+
+cd "$(dirname "$0")/.."
+if [ "$#" -eq 0 ]; then
+  set -- npm run verify:signals
+fi
+exec "$@"
